# PostgreSQL Database Configuration
# Use 'localhost' when running the application natively on your host machine
# Use 'db' when running within Docker Compose
DB_URL=jdbc:postgresql://localhost:5432/levelup_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT Security
# Ensure this is a secure, random string of at least 32 characters for production
JWT_SECRET=your_secure_random_string_at_least_32_chars_long
